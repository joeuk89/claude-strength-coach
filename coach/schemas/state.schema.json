{
  "title": "Program state, data/state.json: rotation, block counters, one-off span, scheme state, Hevy ids (contract C16)",
  "type": "object",
  "required": ["schema_version", "rotation", "block", "one_off", "scheme_state", "hevy"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 4},
    "rotation": {
      "type": "object",
      "required": ["position", "confirmed", "confirmed_at", "week"],
      "additionalProperties": false,
      "properties": {
        "position": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
        "confirmed": {"type": "boolean"},
        "confirmed_at": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "week": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "started", "hard_weeks_completed", "last_closed_week", "last_deep_review", "light_week"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^b-\\d{4,}$"},
        "started": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "hard_weeks_completed": {"type": "integer", "minimum": 0},
        "last_closed_week": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "last_deep_review": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "light_week": {
          "type": "object",
          "required": ["status", "type", "reason", "week", "decision_id"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["not_due", "watch", "skipped", "proposed", "agreed", "declined"]},
            "type": {"enum": ["deload", "light", "return", null]},
            "reason": {"enum": ["ceiling", "triggers", "illness", "coach", null]},
            "week": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "decision_id": {"type": ["string", "null"], "pattern": "^d-\\d+$"}
          }
        }
      }
    },
    "one_off": {
      "type": ["object", "null"],
      "required": ["overlay_id", "span"],
      "additionalProperties": false,
      "properties": {
        "overlay_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"},
        "span": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        }
      }
    },
    "scheme_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["scheme", "data", "pending"],
        "additionalProperties": false,
        "properties": {
          "scheme": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
          "data": {"type": "object"},
          "pending": {
            "type": ["object", "null"],
            "required": ["overlay_id", "data"],
            "additionalProperties": false,
            "properties": {
              "overlay_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"},
              "data": {"type": "object"}
            }
          }
        }
      }
    },
    "hevy": {
      "type": "object",
      "required": ["routines", "folders", "temporary_routines"],
      "additionalProperties": false,
      "properties": {
        "routines": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["session_id"],
            "additionalProperties": false,
            "properties": {"session_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
          }
        },
        "folders": {
          "type": "object",
          "required": ["program", "one_off"],
          "additionalProperties": false,
          "properties": {
            "program": {"type": ["integer", "null"], "minimum": 0},
            "one_off": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "temporary_routines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["routine_id", "overlay_id", "session_id"],
            "additionalProperties": false,
            "properties": {
              "routine_id": {"type": "string", "pattern": "\\S"},
              "overlay_id": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"},
              "session_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"}
            }
          }
        }
      }
    }
  }
}
