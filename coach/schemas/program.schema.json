{
  "title": "The program, data/program.json: sessions, exercises keyed to the library, schedule, blocks (contract C16)",
  "type": "object",
  "required": ["schema_version", "name", "sessions", "external_sessions", "schedule", "blocks", "missed_day_rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 3},
    "name": {"$ref": "#/$defs/text"},
    "sessions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/session"}},
    "external_sessions": {"type": "array", "items": {"$ref": "#/$defs/external_session"}},
    "schedule": {
      "type": "object",
      "required": ["rule", "params"],
      "additionalProperties": false,
      "properties": {
        "rule": {"$ref": "#/$defs/plugin_name"},
        "params": {"type": "object"}
      }
    },
    "blocks": {
      "type": "object",
      "required": ["hard_weeks_ceiling", "deload_rule"],
      "additionalProperties": false,
      "properties": {
        "hard_weeks_ceiling": {"type": "integer", "minimum": 4, "maximum": 8},
        "deload_rule": {
          "type": "object",
          "required": ["name", "params"],
          "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/plugin_name"},
            "params": {"type": "object"}
          }
        }
      }
    },
    "missed_day_rules": {"type": "array", "items": {"$ref": "#/$defs/missed_day_rule"}},
    "dose_targets": {"$ref": "#/$defs/dose_targets"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "optional_text": {"type": ["string", "null"], "pattern": "\\S"},
    "session_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "plugin_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "constraint": {
      "type": "object",
      "required": ["kind", "value", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["rpe_cap", "no_added_load", "load_cap"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "reason": {"$ref": "#/$defs/text"}
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "title", "kind", "tier", "status", "focus", "exercises"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/session_id"},
        "title": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["lifting", "conditioning"]},
        "tier": {"enum": ["core", "optional"]},
        "status": {"enum": ["active", "parked", "standby"]},
        "location": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
        "focus": {"$ref": "#/$defs/optional_text"},
        "exercises": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exercise"}}
      }
    },
    "exercise": {
      "type": "object",
      "required": ["exercise_id", "load_mode", "sets", "rest_seconds", "superset_id", "cues", "constraints", "scheme",
                   "start_load"],
      "additionalProperties": false,
      "properties": {
        "exercise_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "load_mode": {"enum": ["total", "per_hand_x2", "single_implement", "bodyweight", "assisted", "band", "duration", "distance"]},
        "sets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/set_group"}},
        "rest_seconds": {"type": ["integer", "null"], "minimum": 0},
        "superset_id": {"type": ["integer", "null"], "minimum": 0},
        "cues": {"$ref": "#/$defs/optional_text"},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "scheme": {
          "type": "object",
          "required": ["name", "params"],
          "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/plugin_name"},
            "params": {"type": "object"}
          }
        },
        "start_load": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "set_group": {
      "type": "object",
      "required": ["count", "type"],
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "type": {"enum": ["normal", "warmup", "dropset", "failure"]},
        "reps": {"type": ["integer", "null"], "minimum": 1},
        "rep_range": {
          "type": ["object", "null"],
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {"start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}
        },
        "rpe": {"type": ["number", "null"], "minimum": 1, "maximum": 10},
        "duration_seconds": {"type": ["integer", "null"], "minimum": 1},
        "distance_meters": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "external_session": {
      "type": "object",
      "required": ["id", "title", "weekday", "estimated_sets"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/session_id"},
        "title": {"$ref": "#/$defs/text"},
        "weekday": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun", null]},
        "estimated_sets": {"$ref": "#/$defs/muscle_sets"}
      }
    },
    "muscle_sets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abdominals": {"type": "integer", "minimum": 0},
        "front_delts": {"type": "integer", "minimum": 0},
        "side_delts": {"type": "integer", "minimum": 0},
        "rear_delts": {"type": "integer", "minimum": 0},
        "biceps": {"type": "integer", "minimum": 0},
        "triceps": {"type": "integer", "minimum": 0},
        "forearms": {"type": "integer", "minimum": 0},
        "quadriceps": {"type": "integer", "minimum": 0},
        "hamstrings": {"type": "integer", "minimum": 0},
        "calves": {"type": "integer", "minimum": 0},
        "glutes": {"type": "integer", "minimum": 0},
        "abductors": {"type": "integer", "minimum": 0},
        "adductors": {"type": "integer", "minimum": 0},
        "lats": {"type": "integer", "minimum": 0},
        "upper_back": {"type": "integer", "minimum": 0},
        "traps": {"type": "integer", "minimum": 0},
        "lower_back": {"type": "integer", "minimum": 0},
        "chest": {"type": "integer", "minimum": 0},
        "cardio": {"type": "integer", "minimum": 0},
        "neck": {"type": "integer", "minimum": 0},
        "full_body": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "dose_targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abdominals": {"type": "number", "minimum": 0, "maximum": 40},
        "front_delts": {"type": "number", "minimum": 0, "maximum": 40},
        "side_delts": {"type": "number", "minimum": 0, "maximum": 40},
        "rear_delts": {"type": "number", "minimum": 0, "maximum": 40},
        "biceps": {"type": "number", "minimum": 0, "maximum": 40},
        "triceps": {"type": "number", "minimum": 0, "maximum": 40},
        "forearms": {"type": "number", "minimum": 0, "maximum": 40},
        "quadriceps": {"type": "number", "minimum": 0, "maximum": 40},
        "hamstrings": {"type": "number", "minimum": 0, "maximum": 40},
        "calves": {"type": "number", "minimum": 0, "maximum": 40},
        "glutes": {"type": "number", "minimum": 0, "maximum": 40},
        "abductors": {"type": "number", "minimum": 0, "maximum": 40},
        "adductors": {"type": "number", "minimum": 0, "maximum": 40},
        "lats": {"type": "number", "minimum": 0, "maximum": 40},
        "upper_back": {"type": "number", "minimum": 0, "maximum": 40},
        "traps": {"type": "number", "minimum": 0, "maximum": 40},
        "lower_back": {"type": "number", "minimum": 0, "maximum": 40},
        "chest": {"type": "number", "minimum": 0, "maximum": 40},
        "cardio": {"type": "number", "minimum": 0, "maximum": 40},
        "neck": {"type": "number", "minimum": 0, "maximum": 40},
        "full_body": {"type": "number", "minimum": 0, "maximum": 40},
        "other": {"type": "number", "minimum": 0, "maximum": 40}
      }
    },
    "missed_day_rule": {
      "type": "object",
      "required": ["id", "session_id", "condition", "action"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "session_id": {"$ref": "#/$defs/session_id"},
        "condition": {"$ref": "#/$defs/text"},
        "action": {"$ref": "#/$defs/text"}
      }
    }
  }
}
