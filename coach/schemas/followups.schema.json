{
  "title": "Follow-ups, data/followups.json: open coaching questions with a review date (contract C27)",
  "description": "Items are never deleted. Each carries an event log; the newest closing event matches its status. Cross-checks (unique ids, event order, a reason on every drop) are in coach.followups.problems.",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "text": {"type": "string", "pattern": "\\S"},
    "item": {
      "type": "object",
      "required": ["id", "raised", "source", "text", "review_at", "status", "events"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^f-\\d{4,}$"},
        "raised": {"$ref": "#/$defs/date"},
        "source": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "review_at": {"$ref": "#/$defs/date"},
        "status": {"enum": ["open", "resolved", "dropped"]},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "event": {
      "type": "object",
      "required": ["date", "action", "note"],
      "additionalProperties": false,
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "action": {"enum": ["raised", "deferred", "resolved", "dropped", "kept"]},
        "note": {"type": ["string", "null"], "pattern": "\\S"}
      }
    }
  }
}
