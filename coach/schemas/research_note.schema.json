{
  "title": "The hidden data block of a research note, with dates as ISO strings (contract C28)",
  "type": "object",
  "required": ["schema_version", "id", "topic", "question", "written", "review_by", "confidence", "claims"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "topic": {"type": "string", "pattern": "\\S"},
    "question": {"type": "string", "pattern": "\\S"},
    "written": {"$ref": "#/$defs/date"},
    "review_by": {"$ref": "#/$defs/date"},
    "confidence": {"$ref": "#/$defs/confidence"},
    "applies_to": {
      "type": "array",
      "items": {
        "enum": [
          "volume", "frequency", "proximity_to_failure", "progression", "deload", "autoregulation",
          "concurrent_training", "return_to_training", "minimum_dose", "bodyweight_skills", "protein",
          "energy_balance", "sleep", "rehab", "exercise_selection"
        ]
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "updates": {"type": "array", "items": {"$ref": "#/$defs/claim_ref"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "citation", "url", "type", "year"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "citation": {"type": "string", "pattern": "\\S"},
          "url": {"type": "string", "pattern": "^https://\\S+$"},
          "type": {
            "enum": [
              "meta-analysis", "systematic-review", "rct", "observational", "consensus",
              "position-stand", "narrative-review", "preprint", "educator"
            ]
          },
          "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
          "accessed": {"$ref": "#/$defs/date"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "text", "basis", "sources", "status"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "pattern": "\\S"},
          "basis": {"enum": ["evidence", "consensus", "heuristic"]},
          "sources": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["current", "retired"]},
          "confidence": {"$ref": "#/$defs/confidence"},
          "retired_on": {"$ref": "#/$defs/date"},
          "superseded_by": {"$ref": "#/$defs/claim_ref"}
        }
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "confidence": {"enum": ["high", "moderate", "low"]},
    "claim_ref": {"type": "string", "pattern": "^rn:[a-z0-9]+(-[a-z0-9]+)*\\.[0-9]+$"}
  }
}
