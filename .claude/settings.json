{
  "permissions": {
    "allow": [
      "WebFetch(domain:api.hevyapp.com)",
      "Bash(python3 -m coach check:*)",
      "Bash(python3 -m coach units format:*)",
      "Bash(python3 -m coach units convert:*)",
      "Bash(python3 -m coach units round:*)",
      "Bash(python3 -m coach dates week:*)",
      "Bash(python3 -m coach dates span:*)",
      "Bash(python3 -m coach config show:*)",
      "Bash(python3 -m coach config validate:*)",
      "Bash(python3 -m coach version:*)",
      "Bash(python3 -m coach library list:*)",
      "Bash(python3 -m coach library show:*)",
      "Bash(python3 -m coach library search:*)",
      "Bash(python3 -m coach library validate:*)",
      "Bash(python3 -m coach library seed:*)",
      "Bash(python3 -m coach library confirm:*)",
      "Bash(python3 -m coach library set-mode:*)",
      "Bash(python3 -m coach hevy status:*)",
      "Bash(python3 -m coach hevy pull:*)",
      "Bash(python3 -m coach overlay list:*)",
      "Bash(python3 -m coach overlay current:*)",
      "Bash(python3 -m coach overlay validate:*)",
      "Bash(python3 -m coach overlay notes:*)",
      "Bash(python3 -m coach overlay build:*)",
      "Bash(python3 -m coach overlay render:*)",
      "Bash(python3 -m coach overlay approve:*)",
      "Bash(python3 -m coach routines diff:*)",
      "Bash(python3 -m coach routines verify:*)",
      "Bash(python3 -m coach program show:*)",
      "Bash(python3 -m coach program validate:*)",
      "Bash(python3 -m coach program render:*)",
      "Bash(python3 -m coach state show:*)",
      "Bash(python3 -m coach migrate status:*)",
      "Bash(python3 -m coach meals template:*)",
      "Bash(python3 -m coach meals show:*)",
      "Bash(python3 -m coach meals validate:*)",
      "Bash(python3 -m coach meals shopping:*)",
      "Bash(python3 -m coach meals build:*)",
      "Bash(python3 -m coach meals render:*)",
      "Bash(python3 -m coach meals approve:*)",
      "Bash(python3 -m coach status:*)",
      "Bash(python3 -m coach history show:*)",
      "Bash(python3 -m coach history annotations:*)",
      "Bash(python3 -m coach history sync:*)",
      "Bash(python3 -m coach history rebuild:*)",
      "Bash(python3 -m coach history annotate:*)",
      "Bash(python3 -m coach stats e1rm:*)",
      "Bash(python3 -m coach stats adherence:*)",
      "Bash(python3 -m coach stats dose:*)",
      "Bash(python3 -m coach stats durations:*)",
      "Bash(python3 -m coach stats audit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m coach gate pretooluse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m coach hooks sessionstart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m coach hooks posttooluse"
          }
        ]
      }
    ]
  }
}
